# Bilibili live room to monitor.
ROOM_ID=1713546334

# Bark-compatible server base URL. The script posts JSON to ${BARK_URL}/post.
BARK_URL=https://your-bark-server.example

BARK_SOUND=alarm
BARK_VOLUME=5

# Cloudflare account containing the D1 database.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# D1 database ID, not the database name.
BARK_D1_DATABASE_ID=your-bark-d1-database-id

# API token needs Account > D1 > Edit permission.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# systemd provides STATE_DIRECTORY=/var/lib/ez-alarm for the service.
# Without STATE_DIRECTORY, the script falls back to /run/lock/ez-alarm.lock.